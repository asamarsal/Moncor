# Copy this file to .env and replace every REPLACE_* value locally.
# Never commit .env or send PRIVATE_KEY through chat.
PRIVATE_KEY=0xREPLACE_PRIVATE_KEY_LOCALLY
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Public addresses only
FINAL_ADMIN=0xREPLACE_FINAL_ADMIN
TREASURY=0xREPLACE_TREASURY
QUOTE_SIGNER=0xREPLACE_QUOTE_SIGNER
SETTLEMENT_SIGNERS=0xREPLACE_SIGNER_1,0xREPLACE_SIGNER_2,0xREPLACE_SIGNER_3

# Exact threshold and reviewed policy values
SETTLEMENT_THRESHOLD=2
MAX_QUOTE_TTL=30
MAX_START_DELAY=600
